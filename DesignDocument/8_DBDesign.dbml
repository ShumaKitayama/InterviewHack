// =============================================================================
// InterviewHack データベーススキーマ定義（DBML）
// Neon / PostgreSQL 用（改訂：2026-10-22。DirectionChange_20261022.md 2.10.2 に準拠）
// 可視化: https://dbdiagram.io に貼り付けてER図を生成可能
// =============================================================================

Project InterviewHack {
  database_type: 'PostgreSQL'
  Note: 'マルチテナント: 全テーブルは user_id（users.id）で分離。RLS は使わず、Go BFF の Repository が全クエリに user_id = $1 を付けて認可する。DB へのアクセスは BFF のみ。'
}

// -----------------------------------------------------------------------------
// 8.3 ユーザー
// -----------------------------------------------------------------------------
Table users [headercolor: #e8f5e9] {
  id uuid [pk]
  firebase_uid text [not null, unique, note: 'Firebase Auth のユーザー ID']
  email text [null]
  display_name text [null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz [null, note: '退会日時。退会時は email / display_name を消して行を残す（物理削除しない）。設定済みのユーザーは認証失敗（401）']
  Note: '旧 auth_users / profiles を統合。BFF が ID トークン検証後に firebase_uid で取得または作成する。認証情報（パスワード等）は保持しない'
}

// -----------------------------------------------------------------------------
// 8.4 コアドメイン - 自己資産・タグ
// -----------------------------------------------------------------------------
Table assets [headercolor: #fff3e0] {
  id uuid [pk]
  user_id uuid [not null, ref: > users.id]
  type text [not null, note: 'academic|work|project|skill|strength|weakness|episode|other']
  title text [not null]
  content text [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz [null]
  Note: '論理削除: deleted_at'

  indexes {
    user_id
    (user_id, created_at) [name: 'idx_assets_user_created_desc']
  }
}

Table asset_tags [headercolor: #fff3e0] {
  id uuid [pk]
  user_id uuid [not null, ref: > users.id]
  name text [not null]

  indexes {
    (user_id, name) [unique, name: 'uq_asset_tags_user_name']
  }
}

Table asset_tag_relations [headercolor: #fff3e0] {
  asset_id uuid [ref: > assets.id]
  tag_id uuid [ref: > asset_tags.id]
  indexes {
    (asset_id, tag_id) [pk]
  }
  Note: '自己資産とタグの N:M。BFF が asset / asset_tags の user_id 一致を確認して書き込む'
}

// -----------------------------------------------------------------------------
// 8.4 コアドメイン - 企業・ES・面接
// -----------------------------------------------------------------------------
Table companies [headercolor: #fce4ec] {
  id uuid [pk]
  user_id uuid [not null, ref: > users.id]
  name text [not null]
  job_title text [null]
  selection_phase text [null]
  motivation_memo text [null]
  reference_url text [null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz [null]

  indexes {
    user_id
    (user_id, name) [name: 'idx_companies_user_name']
  }
  Note: '論理削除: deleted_at'
}

Table research_materials [headercolor: #fce4ec] {
  id uuid [pk]
  user_id uuid [not null, ref: > users.id]
  company_id uuid [not null, ref: > companies.id]
  title text [not null]
  type text [not null, note: 'url|pdf|note|image']
  source_url text [null]
  content_raw text [null, note: '端末で抽出したテキスト（WebView 本文抽出 / PDFKit / Vision OCR）']
  summary text [null, note: 'AI連携（research_summarize）で取り込んだ要約']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    user_id
    company_id
  }
  Note: 'ファイル本体（PDF・画像）は保存しない'
}

Table es_projects [headercolor: #fce4ec] {
  id uuid [pk]
  user_id uuid [not null, ref: > users.id]
  company_id uuid [not null, ref: > companies.id]
  status text [not null, default: 'not_started', note: 'not_started|draft|in_review|completed|submitted（遷移制約なし。本文の初回保存で not_started → draft）']
  deadline date [null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    user_id
    company_id
    (user_id, status)
  }
}

Table es_sections [headercolor: #fce4ec] {
  id uuid [pk]
  es_project_id uuid [not null, ref: > es_projects.id]
  user_id uuid [not null, ref: > users.id]
  title text [not null, note: '志望動機|自己PR|ガクチカ|...']
  content_draft text [null, note: 'AI連携（es_generate / es_refine）の取り込み先、または編集中の文章']
  content_final text [null]
  character_limit int [null]
  version int [not null, default: 1]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    es_project_id
    user_id
  }
}

Table es_section_versions [headercolor: #fce4ec] {
  id uuid [pk]
  es_section_id uuid [not null, ref: > es_sections.id, note: 'ON DELETE CASCADE']
  user_id uuid [not null, ref: > users.id]
  version int [not null, note: '保存した時点の es_sections.version']
  content text [not null, note: '保存した時点の content_draft']
  source text [not null, note: 'manual|es_generate|es_refine']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (es_section_id, created_at) [name: 'idx_es_section_versions_section_created_desc']
    user_id
  }
  Note: '作成は AI連携の commit で上書きする直前、手動保存、restore の直前のみ。セクションごとに最新20件まで（超過分は作成時に同一トランザクションで削除）'
}

Table es_project_asset_relations [headercolor: #fce4ec] {
  es_project_id uuid [ref: > es_projects.id]
  asset_id uuid [ref: > assets.id]
  indexes {
    (es_project_id, asset_id) [pk]
  }
  Note: 'ESプロジェクトと自己資産の N:M。es_projects.user_id で認可'
}

Table es_project_research_material_relations [headercolor: #fce4ec] {
  es_project_id uuid [ref: > es_projects.id]
  research_material_id uuid [ref: > research_materials.id]
  indexes {
    (es_project_id, research_material_id) [pk]
  }
  Note: 'ESプロジェクトと企業研究資料の N:M。es_projects.user_id で認可'
}

Table interviews [headercolor: #fce4ec] {
  id uuid [pk]
  user_id uuid [not null, ref: > users.id]
  company_id uuid [ref: > companies.id]
  interview_date date [not null]
  phase text [null]
  result text [null, note: 'pass|fail|pending']
  memo text [null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    user_id
    company_id
    (user_id, interview_date) [name: 'idx_interviews_user_date_desc']
  }
}

Table interview_logs [headercolor: #fce4ec] {
  id uuid [pk]
  interview_id uuid [not null, ref: > interviews.id]
  user_id uuid [not null, ref: > users.id]
  question_text text [not null]
  answer_text text [not null]
  self_evaluation text [null]
  ai_feedback_text text [null, note: 'AI連携（answer_review）で取り込んだ指摘・改善案']
  ai_improved_answer_text text [null, note: 'AI連携（answer_review）で取り込んだ改善後の回答']
  score int [null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    user_id
    interview_id
    (user_id, created_at) [name: 'idx_interview_logs_user_created_desc']
  }
}

// -----------------------------------------------------------------------------
// 8.4 コアドメイン - Q&Aバンク
// -----------------------------------------------------------------------------
Table qa [headercolor: #f3e5f5] {
  id uuid [pk]
  user_id uuid [not null, ref: > users.id]
  company_id uuid [null, ref: > companies.id]
  question_text text [not null]
  answer_text text [not null, note: 'qa_generate の【意図N】は保存しない']
  source_type text [not null, note: 'pre_generated|review_improved']
  is_favorite boolean [not null, default: false]
  review_status text [not null, note: 'new|reviewed|needs_review']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    user_id
    (user_id, created_at) [name: 'idx_qa_user_created_desc']
    company_id
  }
}

Table qa_asset_relations [headercolor: #f3e5f5] {
  qa_id uuid [ref: > qa.id]
  asset_id uuid [ref: > assets.id]
  indexes {
    (qa_id, asset_id) [pk]
  }
  Note: 'Q&Aと自己資産の N:M。qa.user_id で認可'
}

// -----------------------------------------------------------------------------
// 8.5 AI連携
// -----------------------------------------------------------------------------
Table prompt_sessions [headercolor: #e0f7fa] {
  id uuid [pk]
  user_id uuid [not null, ref: > users.id]
  use_case text [not null, note: 'qa_generate|answer_review|summary_generate|research_summarize|es_generate|es_refine']
  template_version text [not null, note: '例: qa-v1, review-v1, summary-v1, research-v1, esdraft-v1, esrefine-v1']
  company_id uuid [null, ref: > companies.id]
  es_project_id uuid [null, ref: > es_projects.id]
  es_section_id uuid [null, ref: > es_sections.id]
  interview_id uuid [null, ref: > interviews.id]
  interview_log_id uuid [null, ref: > interview_logs.id]
  input_refs jsonb [not null, default: `'{}'::jsonb`, note: '選んだ自己資産・企業研究資料の ID とオプションのみ。本文は入れない']
  status text [not null, default: 'created', note: 'created|pasted|saved|abandoned']
  parse_result text [null, note: 'success|partial|failed。未解析時は null。解析しないユースケースは parse 時に success']
  created_at timestamptz [not null, default: `now()`]
  pasted_at timestamptz [null]
  completed_at timestamptz [null, note: 'saved / abandoned になった時刻']

  indexes {
    (user_id, status, created_at) [name: 'idx_prompt_sessions_user_status_created']
    (use_case, template_version) [name: 'idx_prompt_sessions_usecase_version']
  }
  Note: '旧 generation_jobs を置き換え（D13）。プロンプト全文・貼り戻した回答の生データは保存しない。commit は status = pasted の条件付き UPDATE で 1 回だけ成功させる（created からの直接 commit は不可）。作成から 7 日を過ぎた created / pasted は一覧取得時に abandoned に更新する'
}

Table dashboard_summaries [headercolor: #e0f7fa] {
  id uuid [pk]
  user_id uuid [not null, ref: > users.id]
  content text [not null, note: 'AI連携（summary_generate）で取り込んだ全文']
  source_interview_id uuid [null, ref: > interviews.id]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, created_at) [name: 'idx_dashboard_summaries_user_created_desc']
  }
  Note: 'ダッシュボードには最新の 1 件を表示する'
}

// -----------------------------------------------------------------------------
// 8.6 共有リンク
// -----------------------------------------------------------------------------
Table share_links [headercolor: #e8eaf6] {
  id uuid [pk]
  user_id uuid [not null, ref: > users.id]
  es_project_id uuid [not null, ref: > es_projects.id]
  token_hash text [not null, unique, note: '共有トークン（32 バイトの暗号学的乱数）の SHA-256 ハッシュ。生トークンは保存しない']
  snapshot jsonb [not null, note: '公開するセクションの title と本文（content_final、なければ content_draft）。show_company_name が真なら企業名。ユーザー名は入れない']
  show_company_name boolean [not null, default: false]
  expires_at timestamptz [not null, note: '作成時刻 + 1 / 7 / 30 日。無期限不可']
  revoked_at timestamptz [null]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    es_project_id
    expires_at [name: 'idx_share_links_expires_at']
  }
  Note: 'D12。閲覧可否は revoked_at IS NULL AND expires_at > now()。ES プロジェクトの削除時・退会時は物理削除。期限切れ・失効した行は運用で定期的に物理削除してよい'
}
