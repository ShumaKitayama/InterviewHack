// =============================================================================
// InterviewHack データベーススキーマ定義（DBML）
// Supabase / PostgreSQL 用
// 可視化: https://dbdiagram.io に貼り付けてER図を生成可能
// =============================================================================

Project InterviewHack {
  database_type: 'PostgreSQL'
  Note: 'マルチテナント: 全テーブルは user_id で分離。RLS で auth.uid() = user_id を原則とする。'
}

// -----------------------------------------------------------------------------
// 認証（Supabase管理・アプリからは参照のみ）
// -----------------------------------------------------------------------------
Table auth_users [headercolor: #e3f2fd] {
  id uuid [pk, note: 'Supabase Auth 管理。アプリからは直接変更しない']
  Note: 'Supabase Auth が管理（Google OAuth + Email/Password）。アプリ側からは直接変更しない'
}

// -----------------------------------------------------------------------------
// 8.2 認証・プロフィール
// -----------------------------------------------------------------------------
Table profiles [headercolor: #e8f5e9] {
  user_id uuid [pk, ref: > auth_users.id]
  display_name text [null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  Note: 'RLS: SELECT/UPDATE/INSERT は auth.uid() = user_id'
}

// -----------------------------------------------------------------------------
// 8.3 コアドメイン - 自己資産・タグ
// -----------------------------------------------------------------------------
Table assets [headercolor: #fff3e0] {
  id uuid [pk]
  user_id uuid [not null, ref: > auth_users.id]
  type text [not null, note: 'academic|work|project|skill|strength|weakness|episode|other']
  title text [not null]
  content text [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz [null]
  Note: 'RLS: 全操作 auth.uid() = user_id。論理削除: deleted_at'
  
  indexes {
    user_id
    (user_id, created_at) [name: 'idx_assets_user_created_desc']
  }
}

Table asset_tags [headercolor: #fff3e0] {
  id uuid [pk]
  user_id uuid [not null, ref: > auth_users.id]
  name text [not null]
  
  indexes {
    (user_id, name) [unique, name: 'uq_asset_tags_user_name']
  }
  Note: 'RLS: 全操作 auth.uid() = user_id'
}

Table asset_tag_relations [headercolor: #fff3e0] {
  asset_id uuid [ref: > assets.id]
  tag_id uuid [ref: > asset_tags.id]
  indexes {
    (asset_id, tag_id) [pk]
  }
  Note: '自己資産とタグの N:M。RLS は asset / asset_tags の user_id に準拠'
}

// -----------------------------------------------------------------------------
// 8.3 コアドメイン - 企業・面接
// -----------------------------------------------------------------------------
Table companies [headercolor: #fce4ec] {
  id uuid [pk]
  user_id uuid [not null, ref: > auth_users.id]
  name text [not null]
  job_title text [null]
  selection_phase text [null]
  motivation_memo text [null]
  reference_url text [null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz [null]
  
  indexes {
    user_id
    (user_id, name) [name: 'idx_companies_user_name']
  }
  Note: 'RLS: 全操作 auth.uid() = user_id。論理削除: deleted_at'
}

Table research_materials [headercolor: #fce4ec] {
  id uuid [pk]
  user_id uuid [not null, ref: > auth_users.id]
  company_id uuid [not null, ref: > companies.id]
  title text [not null]
  type text [not null, note: 'url|pdf|note|image']
  source_url text [null]
  content_raw text [null, note: 'スクレイピング/OCR結果']
  summary text [null, note: 'AI要約']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  
  indexes {
    user_id
    company_id
  }
  Note: 'RLS: 全操作 auth.uid() = user_id'
}

Table es_projects [headercolor: #fce4ec] {
  id uuid [pk]
  user_id uuid [not null, ref: > auth_users.id]
  company_id uuid [not null, ref: > companies.id]
  status text [not null, default: 'draft', note: 'draft|in_review|completed|submitted']
  deadline date [null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  
  indexes {
    user_id
    company_id
    (user_id, status)
  }
  Note: 'RLS: 全操作 auth.uid() = user_id'
}

Table es_sections [headercolor: #fce4ec] {
  id uuid [pk]
  es_project_id uuid [not null, ref: > es_projects.id]
  user_id uuid [not null, ref: > auth_users.id]
  title text [not null, note: '志望動機|自己PR|ガクチカ|...']
  content_draft text [null]
  content_final text [null]
  character_limit int [null]
  version int [not null, default: 1]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  
  indexes {
    es_project_id
    user_id
  }
  Note: 'RLS: 全操作 auth.uid() = user_id'
}

Table es_project_asset_relations [headercolor: #fce4ec] {
  es_project_id uuid [ref: > es_projects.id]
  asset_id uuid [ref: > assets.id]
  indexes {
    (es_project_id, asset_id) [pk]
  }
  Note: 'ESプロジェクトと自己資産の N:M。es_projects.user_id = auth.uid() で制御'
}

Table es_project_research_material_relations [headercolor: #fce4ec] {
  es_project_id uuid [ref: > es_projects.id]
  research_material_id uuid [ref: > research_materials.id]
  indexes {
    (es_project_id, research_material_id) [pk]
  }
  Note: 'ESプロジェクトと企業研究資料の N:M。es_projects.user_id = auth.uid() で制御'
}

Table interviews [headercolor: #fce4ec] {
  id uuid [pk]
  user_id uuid [not null, ref: > auth_users.id]
  company_id uuid [ref: > companies.id]
  interview_date date [not null]
  phase text [null]
  result text [null, note: 'pass|fail|pending']
  memo text [null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  
  indexes {
    user_id
    company_id
    (user_id, interview_date) [name: 'idx_interviews_user_date_desc']
  }
  Note: 'RLS: 全操作 auth.uid() = user_id'
}

Table interview_logs [headercolor: #fce4ec] {
  id uuid [pk]
  interview_id uuid [not null, ref: > interviews.id]
  user_id uuid [not null, ref: > auth_users.id]
  question_text text [not null]
  answer_text text [not null]
  self_evaluation text [null]
  ai_feedback_text text [null]
  ai_improved_answer_text text [null]
  score int [null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  
  indexes {
    user_id
    interview_id
    (user_id, created_at) [name: 'idx_interview_logs_user_created_desc']
  }
  Note: 'RLS: 全操作 auth.uid() = user_id'
}

// -----------------------------------------------------------------------------
// 8.3 コアドメイン - Q&Aバンク
// -----------------------------------------------------------------------------
Table qa [headercolor: #f3e5f5] {
  id uuid [pk]
  user_id uuid [not null, ref: > auth_users.id]
  company_id uuid [null, ref: > companies.id]
  question_text text [not null]
  answer_text text [not null]
  source_type text [not null, note: 'pre_generated|review_improved']
  is_favorite boolean [not null, default: false]
  review_status text [not null, note: 'new|reviewed|needs_review']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  
  indexes {
    user_id
    (user_id, created_at) [name: 'idx_qa_user_created_desc']
    company_id
  }
  Note: 'RLS: 全操作 auth.uid() = user_id'
}

Table qa_asset_relations [headercolor: #f3e5f5] {
  qa_id uuid [ref: > qa.id]
  asset_id uuid [ref: > assets.id]
  indexes {
    (qa_id, asset_id) [pk]
  }
  Note: 'Q&Aと自己資産の N:M。qa.user_id = auth.uid() で制御'
}

// -----------------------------------------------------------------------------
// 8.4 AI / 生成管理（BFF の service role のみ書き込み可）
// -----------------------------------------------------------------------------
Table generation_jobs [headercolor: #e0f7fa] {
  id uuid [pk]
  external_ref text [not null, note: 'クレジット取引と紐付ける外部参照']
  user_id uuid [ref: > auth_users.id]
  job_type text [not null, note: 'qa_generate|answer_review|summary_generate|research_summarize|es_generate|es_refine']
  input_snapshot jsonb [not null]
  model_name text [not null]
  token_used int [null]
  cost_estimate numeric [null]
  status text [not null, note: 'success|failed']
  error_code text [null]
  error_message text [null]
  created_at timestamptz [not null, default: `now()`]
  
  indexes {
    (user_id, created_at) [name: 'idx_generation_jobs_user_created_desc']
    job_type
  }
  Note: 'SELECT: auth.uid()=user_id。INSERT/UPDATE: BFF service role のみ。DELETE: 管理者のみ'
}

// -----------------------------------------------------------------------------
// 8.5 クレジット課金系（BFF の service role のみ書き込み可）
// -----------------------------------------------------------------------------
Table credit_balances [headercolor: #fff8e1] {
  user_id uuid [pk, ref: > auth_users.id]
  balance int [not null, default: 0, note: 'CHECK (balance >= 0)']
  updated_at timestamptz [not null, default: `now()`]
  Note: 'SELECT: auth.uid()=user_id。UPDATE/INSERT: BFF service role のみ'
}

Table credit_transactions [headercolor: #fff8e1] {
  id uuid [pk]
  user_id uuid [not null, ref: > auth_users.id]
  type text [not null, note: 'purchase|consume|bonus|adjustment']
  amount int [not null]
  status text [not null, note: 'pending|committed|reversed']
  reason text [not null]
  external_ref text [not null]
  created_at timestamptz [not null, default: `now()`]
  
  indexes {
    (user_id, created_at) [name: 'idx_credit_tx_user_created_desc']
    external_ref
    (user_id, external_ref, type) [unique, name: 'uq_credit_tx_user_ref_type']
  }
  Note: 'SELECT: auth.uid()=user_id。INSERT/UPDATE: BFF service role のみ'
}

Table stripe_events [headercolor: #fff8e1] {
  id text [pk, note: 'Stripe event.id']
  received_at timestamptz [not null, default: `now()`]
  
  indexes {
    (received_at) [name: 'idx_stripe_events_received_desc']
  }
  Note: 'SELECT: 管理者のみ。INSERT: BFF service role のみ'
}

Table credit_packages [headercolor: #e8eaf6] {
  id uuid [pk]
  name text [not null]
  credits int [not null]
  stripe_price_id text [not null]
  is_active boolean [not null, default: true]
  Note: '商品マスタ。SELECT: 全ユーザー(is_active=true)。変更: 管理者/service role のみ'
}

Table credit_costs [headercolor: #e8eaf6] {
  feature text [pk, note: 'qa_generate|answer_review|summary_generate|regenerate|research_summarize|es_generate|es_refine']
  cost int [not null]
  is_active boolean [not null, default: true]
  Note: '機能ごとの消費量。SELECT: 全ユーザー。UPDATE: 管理者/service role のみ'
}
