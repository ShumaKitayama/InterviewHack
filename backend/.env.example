# DesignDocument/14_CICDDesign.md 14.8.2 バックエンド環境変数
ENV=dev
PORT=8080
RELEASE=dev

# Supabase
DATABASE_URL=postgresql://postgres:password@db.xxx.supabase.co:5432/postgres
SUPABASE_JWT_SECRET=your-jwt-secret

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
