# DesignDocument/14_CICDDesign.md 14.8.1 / DirectionChange_20261022.md 2.10.6
APP_ENV=dev
PORT=8080
LOG_LEVEL=info

# Neon (PostgreSQL). dev はローカル PostgreSQL か Neon の dev ブランチ
DATABASE_URL=postgres://postgres@localhost:5432/interviewhack

# Firebase Auth の ID トークン検証（aud）。サービスアカウントキーは不要
FIREBASE_PROJECT_ID=your-firebase-dev-project-id

# 共有リンクの URL の基点（https://<Cloud Run の URL>）
SHARE_BASE_URL=http://localhost:8080

# フィーチャーフラグ（12.11）。未設定は on
FEATURE_SHARE_VIEW=on
FEATURE_SHARE_CREATE=on
FEATURE_COMMIT_DISABLED_USE_CASES=
